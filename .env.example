# Public site URL, used for canonical links and as the host Google redirects back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave empty. The browser stays on this site, and Next proxies API paths to BACKEND_URL.
NEXT_PUBLIC_API_URL=

# Java API. On Vercel, set this to the Kubernetes API address.
BACKEND_URL=http://localhost:8080

# The website does not read the database, Google, session, or SMTP settings.
# Those belong in the surshongi-backend service. scripts/smoke.mts still needs
# DATABASE_URL and the same SESSION_SECRET as the API when you run it locally.
